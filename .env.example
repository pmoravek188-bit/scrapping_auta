# Used by packages/scrapers (the GitHub Actions cron runner / `pnpm scrape`).
# Copy to .env and fill in for local runs; in GitHub Actions these are repo Secrets.

SUPABASE_URL=https://lhzfrzfutlzqysyuldtw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional: email notifications via Resend (https://resend.com). Both must be
# set for notifications to be sent — otherwise they are silently skipped.
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
# Optional, defaults to "Scrapping auta <onboarding@resend.dev>". On Resend's
# free tier without your own verified domain you can only send FROM
# onboarding@resend.dev TO the email address of the Resend account owner.
NOTIFY_EMAIL_FROM=
